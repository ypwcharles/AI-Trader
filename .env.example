## OpenAI-compatible endpoint (SiliconFlow)
OPENAI_API_BASE="https://api.siliconflow.cn/v1"
OPENAI_API_KEY="YOUR_DEEPSEEK_API_KEY_HERE"
ALPHAADVANTAGE_API_KEY =""
JINA_API_KEY=""

# Finnhub settings (for price data)
FINNHUB_API_KEY=""
# FINNHUB_API_BASE="https://finnhub.io/api/v1"

MATH_HTTP_PORT=8000
SEARCH_HTTP_PORT=8001
TRADE_HTTP_PORT=8002
GETPRICE_HTTP_PORT=8003

AGENT_MAX_STEP=30

RUNTIME_ENV_PATH = ""

# Set to true to trade today's session automatically
# When enabled, init date becomes previous trading day, end date is today
# RUN_TODAY=true

# Optional market calendar settings (used when RUN_TODAY is enabled)
# MARKET_TZ defaults to America/New_York; MARKET_OPEN defaults to 09:30
# MARKET_TZ=America/New_York
# MARKET_OPEN=09:30

# Merging behavior for latest day
# If true, keep today's close ('4. sell price') when merging, otherwise
# keep only today's open to avoid look-ahead. If not set, script will auto-keep
# close after MARKET_CLOSE in MARKET_TZ.
# MERGE_INCLUDE_TODAY_CLOSE=false
# MARKET_CLOSE=16:00

# Alternatively, set explicit dates (YYYY-MM-DD)
# INIT_DATE=
# END_DATE=
